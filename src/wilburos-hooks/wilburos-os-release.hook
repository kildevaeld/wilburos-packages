[Trigger]
Operation = Install
Operation = Upgrade
Type = Package
Target = filesystem

[Action]
Description = Updating Wilburos OS-Specific Configurations...
When = PostTransaction
Exec = /usr/share/wilburos/bin/wilbur-hooks os-release
