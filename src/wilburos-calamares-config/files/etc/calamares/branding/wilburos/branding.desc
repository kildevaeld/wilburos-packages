images:
    productIcon:         "icon.svg"
    productLogo:         "logo.svg"

style:
   SidebarBackground:        "#1b1d23"
   SidebarText:              "#EFF0F1"
   SidebarTextCurrent:       "#FFFFFF"
   SidebarBackgroundCurrent: "#5e6ad2"
